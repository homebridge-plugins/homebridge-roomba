{
  "name": "@homebridge-plugins/homebridge-roomba",
  "displayName": "Roomba",
  "type": "module",
  "version": "3.0.3",
  "description": "homebridge-plugin for Roomba devices",
  "author": {
    "name": "RayanKhan"
  },
  "license": "MIT",
  "homepage": "https://github.com/homebridge-plugins/homebridge-roomba#readme",
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge-plugins/homebridge-roomba.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-roomba/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-matter",
    "supports-hap",
    "iRobot",
    "Roomba"
  ],
  "main": "./dist/index.js",
  "engines": {
    "homebridge": "^1.11.4 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0"
  },
  "maintainers": [
    {
      "name": "karlvr"
    }
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "watch": "npm run build && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "rimraf ./dist && tsc && npm run plugin-ui",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "roomba:getpassword": "get-roomba-password",
    "roomba:getlastcommand": "node ./dist/lastcommand.js",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "dorita980": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "homebridge": "^2.2.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "request": {
      "form-data": "^2.5.6",
      "qs": "^6.15.3"
    }
  }
}
